{
  "name": "vue-django-with-tests",
  "version": "0.0.1",
  "description": "Vue-Django Gitlab CI/CD Setup with Docker Images and Cypress Tests (and Django Unit Tests)",
  "main": "src/main.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "dev": "webpack-dev-server --inline --progress --config build/webpack.dev.conf.js",
    "test": "cypress run",
    "test-ci": "cypress run --config baseUrl=http://docker:8000",
    "build": "node build/build.js",
    "lint": "eslint --ext .js,.vue src test/unit/specs test/e2e/specs"
  },
  "repository": {
    "type": "git",
    "url": "git@gitlab.electrocnic.com:dood/app.git"
  },
  "keywords": [
    "Docker",
    "CI/CD",
    "Vue",
    "Django",
    "Cypress",
    "Dind",
    "Dood",
    "Automatic",
    "Docker-Images"
  ],
  "author": "Andreas Wiesinger",
  "license": "MIT",
  "engines": {
    "node": ">= 10.1.0",
    "npm": ">= 6.4.1"
  },
  "dependencies": {
    "@babel/runtime": "^7.5.5",
    "axios": "^0.19.0",
    "bootstrap": "^4.3.1",
    "bootstrap-sass": "^3.4.1",
    "bootstrap-vue": "^2.0.0-rc.28",
    "jquery": "^3.4.1",
    "lodash": "^4.17.15",
    "vue": "^2.6.10",
    "vue-router": "^3.1.2",
    "vuex": "^3.1.1"
  },
  "devDependencies": {
