{
  "name": "odpr",
  "version": "1.0.4",
  "description": "A database where everybody can upload their 3D Models and scenes to provide templates for experimental render-algorithms and to test and compare their outputs",
  "main": "src/main.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "dev": "webpack-dev-server --inline --progress --config build/webpack.dev.conf.js",
    "test": "cypress run --browser chromium",
    "test-ci": "cypress run --config baseUrl=http://docker:8000 --browser chrome",
    "build": "node build/build.js",
    "lint": "eslint --ext .js,.vue src",
    "lint-fix": "eslint --fix --ext .js,.vue src"
  },
  "repository": {
    "type": "git",
    "url": "git@gitlab.com:electrocnic/odpr.git"
